{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JOYA AI",
  "mainBinaryName": "JOYA AI",
  "version": "0.1.14",
  "identifier": "com.joya.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://joya.example.com",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Joya",
    "copyright": "Joya",
    "category": "Productivity",
    "shortDescription": "JOYA AI on your desktop",
    "longDescription": "The JOYA AI Command Center on the Windows desktop: the core, the sessions, chat, voice and approvals, with no window around them.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "JOYA AI"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4MkNERURBMkU5NzMxNEMKUldSTU1aY3UydDRzK0h3Z0pqc200NDc0S0pJNVVSbWZXQkhDT2tHaVNYTVBqZ21udEtPR2g5V04K",
      "endpoints": ["https://joya.example.com/desktop/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
