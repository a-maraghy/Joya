# Copy to .env in the project root (chmod 600) and fill in.
TELEGRAM_BOT_TOKEN=<bot-token-from-BotFather>
TELEGRAM_BOT_USERNAME=<bot-username>
APPROVED_DIRECTORY=/opt/projects
ALLOWED_USERS=<your-telegram-user-id>
ENABLE_TOKEN_AUTH=false
DISABLE_SECURITY_PATTERNS=true
DISABLE_TOOL_VALIDATION=false
USE_SDK=true
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_MAX_TURNS=100
CLAUDE_TIMEOUT_SECONDS=1800
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=60
DATABASE_URL=sqlite:///data/bot.db
SESSION_TIMEOUT_HOURS=720
MAX_SESSIONS_PER_USER=10
# === PERSISTENT MEMORY ===
# A Telegram session can end or be reset at any time, and nothing in the
# conversation survives it -- only files do. When enabled, MEMORY.md from the
# project directory is injected into the system prompt on EVERY request, so the
# assistant always starts knowing what has already been done.
ENABLE_PERSISTENT_MEMORY=true

# Create MEMORY.md / WORKLOG.md / memory/ in a project that has none
MEMORY_SCAFFOLD_ON_START=true

# Max characters read from CLAUDE.md and MEMORY.md (each) before truncation
CONTEXT_FILE_MAX_CHARS=24000

ENABLE_MCP=false
ENABLE_GIT_INTEGRATION=true
ENVIRONMENT=production
DEVELOPMENT_MODE=false
